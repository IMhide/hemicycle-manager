# Dependencies and build artefacts
node_modules
.svelte-kit
build

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Generated data — regenerable via `npm run data:fetch`
# Heavy (~75 MB) and always-fresh-from-source, so we don't track it.
# Note : on ignore le CONTENU du dossier (pas le dossier lui-même) pour
# permettre la négation `!elus-overrides.json` ci-dessous (git ne ré-inclut
# pas un fichier dont le dossier parent est ignoré).
static/data/*
static/data/**/
# Exception : overrides manuels du manifest bicaméral elus.json (cf ADR 0031).
# Petit fichier JSON commité (modification = audit/PR), source de vérité du
# matching cross-chambre Larcher/Schiappa/etc. Le pipeline le lit en input.
!static/data/elus-overrides.json
# Exception : table de familles politiques pour neutraliser les renommages de
# groupes (LFI/LFI-NUPES/LFI-NFP, etc.). Source de vérité du badge Recomposition
# (cf ADR 0034). Modification = audit/PR.
!static/data/groupes-familles.json

# Editor / OS
.DS_Store
.idea
.vscode
*.log

# Misc
.vercel
.cache
.coolify

# Local agent state (Claude Code, thoughts/handoffs)
.claude/
thoughts/
prompt.md

# Artefacts du tool de screenshot (Playwright MCP)
.playwright-mcp/

# Screenshots de QA générés à la racine (ne pas committer)
/*.png
